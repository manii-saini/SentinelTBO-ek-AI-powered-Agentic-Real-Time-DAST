{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@sentinel/shared": ["packages/shared/src/index.ts"],
      "@sentinel/agents": ["packages/agents/src/index.ts"]
    }
  },
  "include": ["packages/*/src/**/*", "apps/*/src/**/*", "scripts/**/*", "packages/agents/test/**/*"]
}
